# ---------------------------------------------------------------------------
# Core (required)
# ---------------------------------------------------------------------------

# SQLite for local dev. Swap for a Postgres URL in production.
DATABASE_URL="file:./dev.db"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me"
NEXTAUTH_URL="http://localhost:3000"

# Public origin used to build Stripe redirect URLs. Defaults to NEXTAUTH_URL.
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Stripe — real payments and handicapper payouts
# Without these the app falls back to the demo wallet.
# Keys: https://dashboard.stripe.com/apikeys
# ---------------------------------------------------------------------------

# STRIPE_SECRET_KEY="sk_test_..."

# REQUIRED for money to actually land. Wallet credit and subscription access are
# only granted by a verified webhook, never by the browser redirect.
#   Local:      stripe listen --forward-to localhost:3000/api/stripe/webhook
#   Production: add an endpoint for /api/stripe/webhook in the Stripe dashboard
# Send these events: checkout.session.completed, invoice.paid,
# customer.subscription.updated, customer.subscription.deleted, account.updated
# STRIPE_WEBHOOK_SECRET="whsec_..."

# Platform's cut of every sale, as a percent. Handicappers keep the remainder.
# PLATFORM_FEE_PERCENT=20

# ---------------------------------------------------------------------------
# The Odds API — live games, lines, and scores
# Without this the seeded games stay in place.
# Key: https://the-odds-api.com/
# ---------------------------------------------------------------------------

# ODDS_API_KEY="..."

# Which sports to pull. Each sport costs API credits per sync, so keep it tight.
# Supported: NFL,NCAAF,NBA,NCAAB,MLB,NHL,SOCCER,MMA
# ODDS_API_SPORTS="NFL,NBA,MLB,NHL"

# ---------------------------------------------------------------------------
# Scheduled jobs
# Lets a cron call POST /api/admin/sync-odds and /api/admin/grade without a
# logged-in admin session. Generate with: openssl rand -hex 32
# ---------------------------------------------------------------------------

# GRADING_CRON_SECRET="..."

# ---------------------------------------------------------------------------
# LiveKit — real video in the stream rooms
# Without these the broadcaster gets a local preview only.
# Keys: https://cloud.livekit.io/ (or self-host)
# ---------------------------------------------------------------------------

# LIVEKIT_API_KEY="API..."
# LIVEKIT_API_SECRET="..."
# NEXT_PUBLIC_LIVEKIT_URL="wss://your-project.livekit.cloud"
